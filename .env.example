# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://herald:herald@127.0.0.1:5432/herald

# Postgres (used by docker-compose; defaults to "herald" for user/db if unset)
POSTGRES_DB=herald
POSTGRES_USER=herald
POSTGRES_PASSWORD=change-me-strong-password

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# Encryption (AES-256: must be exactly 32 characters)
CRYPTO_KEY=change-me-to-32-chars-exactly-!!

# Email — Resend SDK (emails do sistema: recuperação de senha, alertas)
RESEND_API_KEY=
SMTP_FROM="Herald <no-reply@example.com>"

# SMTP — Não mais necessário para emails do sistema (usando Resend SDK)
# Mantido apenas para canais Email por-organização cadastrados na plataforma
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password

# WhatsApp sessions (Baileys)
WA_SESSIONS_PATH=./whatsapp-sessions

# Timezone for daily reset cron (sentToday=0). IANA name, default UTC.
# For Brazil: America/Sao_Paulo (BRT, UTC-3) or America/Manaus (AMT, UTC-4)
DAILY_RESET_TZ=UTC

# Seed (initial OWNER user)
SEED_OWNER_NAME="Administrador"
SEED_OWNER_EMAIL=admin@herald.app
SEED_OWNER_PASSWORD=Admin@1234
